# Printer IP address (assign a static lease in your router)
BAMBULAB_HOST=192.168.1.100

# Serial number — printer screen, or from the printer's TLS certificate:
#   echo | openssl s_client -connect <printer-ip>:8883 2>/dev/null | grep subject
BAMBULAB_SERIAL=01P00A000000000

# LAN access code — printer screen: Settings -> WLAN
BAMBULAB_ACCESS_CODE=12345678

# Optional: printer_name label on all metrics (nice for multi-printer setups)
BAMBULAB_PRINTER_NAME=P1S
