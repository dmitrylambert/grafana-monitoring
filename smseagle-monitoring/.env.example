# Copy this file to ".env" and fill in your real values.
# The .env file is gitignored and is the ONLY place the token is stored.

# SMSEagle APIv2 base URL (no trailing slash).
# Replace <smseagle-ip> with your device's LAN IP or hostname.
# If full_info returns 404, switch to: https://<smseagle-ip>/index.php/api/v2
SMSEAGLE_API_URL=https://<smseagle-ip>/api/v2

# APIv2 Access Token generated in SMSEagle Web-GUI > Users > Access to API.
SMSEAGLE_ACCESS_TOKEN=PASTE_YOUR_TOKEN_HERE
