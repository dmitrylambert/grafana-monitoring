# Copy to ".env" (gitignored) and fill in.

# SMSEagle APIv2 base URL (the device, reachable from this container).
SMSEAGLE_API_URL=https://192.168.1.213/api/v2

# APIv2 token. Needs "Send SMS" for SMS, and "Send calls" for voice calls.
SMSEAGLE_ACCESS_TOKEN=PASTE_YOUR_TOKEN_HERE

# Comma-separated recipient phone numbers (international format) for SMS.
SMSEAGLE_SMS_TO=+37120000000

# --- Voice call ---
# An alert becomes a voice call (instead of SMS) when it carries the label
# smseagle_channel=call (or voice/tts). SMS is the default. See README.
# Recipients for voice calls. If unset, falls back to SMSEAGLE_SMS_TO.
#SMSEAGLE_CALL_TO=+37120000000
# TTS voice model id (SMSEagle menu: Calls > TTS Voice models). Default 1.
#SMSEAGLE_VOICE_ID=1
# Voice-call duration in seconds. Default 10.
#SMSEAGLE_CALL_DURATION=10
# Alert label name used to pick the channel. Default smseagle_channel.
#SMSEAGLE_CHANNEL_LABEL=smseagle_channel
# Alert label name used to override recipients per alert. Default smseagle_to.
# (An alert carrying e.g. smseagle_to="+371...,+372..." goes to those numbers
#  instead of SMSEAGLE_SMS_TO/SMSEAGLE_CALL_TO.)
#SMSEAGLE_TO_LABEL=smseagle_to

# true = validate via SMSEagle without actually delivering (use for testing).
SMSEAGLE_TEST_MODE=false

# true = skip TLS verification (SMSEagle uses a self-signed cert on the LAN).
SMSEAGLE_INSECURE_TLS=true
